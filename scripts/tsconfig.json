{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "types": ["chrome-types", "vite/client"],
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["*.ts", "*.tsx", "debug-scripts/debug-transcript-backend.ts", "popup/popup.tsx", "popup/PopupApp.tsx", "llm/offscreen.ts", "llm/webgpu-transcript-processing.ts", "llm/background.ts", "transcript-capture/contentScript.ts", "transcript-capture/get-youtube-content.ts"],
  "exclude": ["node_modules"]
}
